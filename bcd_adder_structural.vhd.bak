library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity bcd_adder_structural is
port(
    A : in std_logic_vector(3 downto 0);
    B : in std_logic_vector(3 downto 0);
    S : out std_logic_vector(3 downto 0);
    C : out std_logic
);
end bcd_adder_structural;

architecture structural of bcd_adder_structural is

signal temp : unsigned(4 downto 0);

begin

temp <= unsigned(A) + unsigned(B);

process(temp)
begin

    if temp > 9 then
        S <= std_logic_vector((temp + 6)(3 downto 0));
        C <= '1';
    else
        S <= std_logic_vector(temp(3 downto 0));
        C <= '0';
    end if;

end process;

end structural;